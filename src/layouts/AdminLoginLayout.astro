---
import "../styles/global.css";
---

<!doctype html>
<html lang="ru">
  <head>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) return "dark";
        return "light";
      })();
      document.documentElement.setAttribute("data-theme", theme === "light" ? "light" : "dark");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Вход в админку — OBS Intellect</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/admin/admin.css" />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink">
    <header class="border-b border-line">
      <div class="wrap py-5">
        <p class="text-base font-semibold sm:text-lg">ОБС Интеллект</p>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <script is:inline src="/admin/app.js"></script>
  </body>
</html>
