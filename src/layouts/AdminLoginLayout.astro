---
import "../styles/global.css";
import BrandIcons from "../components/BrandIcons.astro";
import Logo from "../components/Logo.astro";
---

<!doctype html>
<html lang="ru">
  <head>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) return "dark";
        return "light";
      })();
      document.documentElement.setAttribute("data-theme", theme === "light" ? "light" : "dark");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Вход в админку — ОБС Интеллект</title>
    <BrandIcons lang="ru" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/admin/admin.css" />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink">
    <header class="border-b border-line">
      <div class="wrap py-5">
        <Logo lang="ru" />
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <script is:inline src="/admin/app.js"></script>
  </body>
</html>
