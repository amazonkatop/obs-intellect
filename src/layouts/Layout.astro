---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Seo from "../components/Seo.astro";
import { localeFromAstro } from "../lib/i18n";
import { SITE } from "../lib/types";

interface Props {
  title: string;
  description: string;
  locale?: "en" | "ru";
  schema?: unknown[];
}

const locale = Astro.props.locale ?? localeFromAstro(Astro.currentLocale);
const { title, description, schema = [] } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${Astro.site?.toString() ?? ""}#org`,
      name: SITE.legalShort,
      alternateName: SITE.name,
      url: Astro.site?.toString(),
      email: SITE.email,
      description: locale === "ru" ? SITE.descriptionRu : SITE.description,
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      document.documentElement.setAttribute("data-theme", theme === "light" ? "light" : "dark");
      window.localStorage.setItem("theme", theme === "light" ? "light" : "dark");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=PT+Serif:ital,wght@0,400;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var KEY = "obs-intellect-locale-manual";
        document.addEventListener("click", function (e) {
          var target = e.target;
          if (!target || !target.closest) return;
          var a = target.closest("[data-locale-manual]");
          if (!a) return;
          try {
            localStorage.setItem(KEY, a.getAttribute("data-locale-manual") || "1");
          } catch (err) {}
        });
        try {
          if (localStorage.getItem(KEY)) return;
          var path = location.pathname;
          if (path === "/ru" || path.indexOf("/ru/") === 0) return;
          var lang = String(navigator.language || "").toLowerCase();
          if (lang === "ru" || lang.indexOf("ru-") === 0) {
            location.replace("/ru");
          }
        } catch (err) {}
      })();
    </script>
    <Seo title={title} description={description} lang={locale} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink">
    <a class="skip-link" href="#content">{locale === "ru" ? "К содержанию" : "Skip to content"}</a>
    <Header />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
