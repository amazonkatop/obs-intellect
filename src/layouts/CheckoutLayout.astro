---
import "../styles/global.css";
import PayMarks from "../components/PayMarks.astro";
import Seo from "../components/Seo.astro";
import { LEGAL_PATHS } from "../lib/pay";
import { localeFromAstro } from "../lib/i18n";
import { SITE } from "../lib/types";

interface Props {
  title: string;
  description: string;
  locale?: "en" | "ru";
  robots?: string;
}

const locale = Astro.props.locale ?? localeFromAstro(Astro.currentLocale);
const { title, description, robots = "noindex,nofollow" } = Astro.props;
const home = locale === "ru" ? "/ru" : "/";
const store = locale === "ru" ? "/ru/pay" : "/pay";
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      document.documentElement.setAttribute("data-theme", theme === "light" ? "light" : "dark");
      window.localStorage.setItem("theme", theme === "light" ? "light" : "dark");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <Seo title={title} description={description} lang={locale} robots={robots} />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink">
    <a class="skip-link" href="#content">{locale === "ru" ? "К содержанию" : "Skip to content"}</a>
    <header class="border-b border-line">
      <div class="wrap flex items-center justify-between py-5">
        <a href={home} class="text-base font-semibold text-ink no-underline sm:text-lg">
          {locale === "ru" ? "ОБС Интеллект" : SITE.name}
        </a>
        <div class="flex items-center gap-4 text-xs">
          <a href={store} class="text-primary no-underline hover:underline">
            {locale === "ru" ? "Оплата" : "Pay"}
          </a>
          <span class="text-muted">{SITE.legalShort}</span>
        </div>
      </div>
    </header>
    <main id="content" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line">
      <div class="wrap py-8">
        <PayMarks />
        <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label={locale === "ru" ? "Юридические документы" : "Legal"}>
          <a class="text-primary no-underline hover:underline" href={LEGAL_PATHS.refund}>
            {locale === "ru" ? "Правила возврата" : "Refund policy"}
          </a>
          <a class="text-primary no-underline hover:underline" href={LEGAL_PATHS.offer}>
            {locale === "ru" ? "Публичная оферта" : "Public offer"}
          </a>
          <a class="text-primary no-underline hover:underline" href={LEGAL_PATHS.privacy}>
            {locale === "ru" ? "Политика обработки персональных данных" : "Personal data policy"}
          </a>
        </nav>
        <p class="mt-4 text-xs leading-5 text-muted">
          {SITE.legalShort}. {locale === "ru" ? "Оплата банковской картой через Т-Кассу." : "Card payments via T-Bank (T-Kassa)."}
        </p>
      </div>
    </footer>
  </body>
</html>
