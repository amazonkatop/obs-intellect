---
import CaseArticle from "../../components/CaseArticle.astro";
import Layout from "../../layouts/Layout.astro";
import { getCases } from "../../lib/db";
import { caseFields } from "../../lib/i18n";
import type { CaseRecord } from "../../lib/types";

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: CaseRecord;
}

const { item } = Astro.props;
const copy = caseFields(item, "en");
---

<Layout locale="en" title={`${item.client_name} — case`} description={copy.description}>
  <CaseArticle item={item} />
</Layout>
