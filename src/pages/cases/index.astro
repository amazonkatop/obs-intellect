---
import Breadcrumb from "../../components/Breadcrumb.astro";
import CaseCard from "../../components/CaseCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import CtaPair from "../../components/CtaPair.astro";
import Layout from "../../layouts/Layout.astro";
import { CASES_INDEX } from "../../lib/copy/cases";
import { HOME } from "../../lib/copy/home";
import { getCases } from "../../lib/db";
import { caseFields } from "../../lib/i18n";

const cases = await getCases();
const meta = CASES_INDEX.en;
const copy = HOME.en;
---

<Layout locale="en" title={meta.title} description={meta.description}>
  <div class="wrap py-16 md:py-24">
    <Breadcrumb items={[{ href: "/", label: "Home" }, { href: "/cases", label: "Cases" }]} />
    <p class="badge mt-8">Cases</p>
    <h1 class="page-h1 mt-4 max-w-3xl">
      Business problem. Insight. Solution. Result.
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">
      We do not publish “we built an app on React”. Each case starts from how the company worked,
      what the audit found, what we implemented, and which number moved.
    </p>
    <div class="mt-8">
      <CtaPair locale="en" />
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        cases.map((item) => {
          const view = caseFields(item, "en");
          return (
            <CaseCard
              href={`/cases/${item.slug}`}
              industry={view.industry}
              employees={view.employees}
              title={view.title}
              subtitle={view.subtitle}
              metrics={view.metrics}
              readLabel="Read the case"
            />
          );
        })
      }
    </div>
  </div>

  <CtaBand h2={copy.finalH2} text={copy.final} locale="en" />
</Layout>
