---
import Layout from "../layouts/Layout.astro";
import { HOME } from "../lib/copy/home";
import { isRuPath } from "../lib/i18n";

const ru = isRuPath(Astro.url.pathname);
const locale = ru ? "ru" : "en";
const copy = HOME[locale];
---

<Layout
  locale={locale}
  title={ru ? "Страница не найдена" : "Page not found"}
  description={ru ? "Запрошенный адрес отсутствует на сайте ООО «ОБС Интеллект»." : "The requested page does not exist on the OBS Intellect site."}
>
  <div class="wrap py-24">
    <h1 class="page-h1">{ru ? "Страница не найдена" : "Page not found"}</h1>
    <p class="mt-4 max-w-xl text-base leading-7 text-muted">
      {ru
        ? "Этого адреса нет в статической версии сайта. Вернитесь на главную или запустите AI-аудит, если искали, с чего начать."
        : "This URL is not part of the static site. Go home, or start an AI audit if you were looking for where to begin."}
    </p>
    <p class="mt-8 flex flex-wrap gap-3">
      <a href={ru ? "/ru" : "/"} class="btn-secondary">{ru ? "На главную" : "Home"}</a>
      <a href={ru ? "/ru/ai-audit" : "/ai-audit"} class="btn-primary">{copy.ctaPrimary}</a>
    </p>
  </div>
</Layout>
