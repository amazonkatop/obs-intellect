---
import AdminLoginLayout from "../../../layouts/AdminLoginLayout.astro";
---

<AdminLoginLayout>
  <div class="wrap narrow py-16 md:py-24">
    <p class="badge">Админка</p>
    <h1 class="page-h1 mt-4">Вход</h1>
    <p class="mt-5 text-base leading-7 text-muted" data-auth-copy>
      Пароль задаётся на этой странице. Если забудете — создайте новый, указав почту администратора.
    </p>
    <p class="mt-10 text-sm text-muted" data-auth-boot>Загрузка…</p>

    <form class="mt-10 panel" data-admin-setup hidden>
      <label class="block text-sm text-muted" for="setup-email">Почта администратора</label>
      <input
        id="setup-email"
        name="email"
        type="email"
        required
        autocomplete="username"
        class="mt-1 w-full border border-line bg-canvas px-3 py-2 text-ink"
      />
      <label class="mt-5 block text-sm text-muted" for="setup-password">Пароль</label>
      <input
        id="setup-password"
        name="password"
        type="password"
        required
        minlength="8"
        autocomplete="new-password"
        class="mt-1 w-full border border-line bg-canvas px-3 py-2 text-ink"
      />
      <label class="mt-5 block text-sm text-muted" for="setup-repeat">Повтор пароля</label>
      <input
        id="setup-repeat"
        name="repeat"
        type="password"
        required
        minlength="8"
        autocomplete="new-password"
        class="mt-1 w-full border border-line bg-canvas px-3 py-2 text-ink"
      />
      <button type="submit" class="btn-primary mt-6 w-full">Создать пароль и войти</button>
      <p class="mt-3 text-sm text-muted" data-login-status></p>
    </form>

    <form class="mt-10 panel" data-admin-login hidden>
      <label class="block text-sm text-muted" for="password">Пароль</label>
      <input
        id="password"
        name="password"
        type="password"
        required
        autocomplete="current-password"
        class="mt-1 w-full border border-line bg-canvas px-3 py-2 text-ink"
      />
      <button type="submit" class="btn-primary mt-6 w-full">Войти</button>
      <button type="button" class="mt-4 w-full text-sm text-primary" data-show-reset>Забыли пароль?</button>
      <p class="mt-3 text-sm text-muted" data-login-status></p>
    </form>

    <form class="mt-10 panel" data-admin-reset hidden>
      <label class="block text-sm text-muted" for="reset-email">Почта администратора</label>
      <input
        id="reset-email"
        name="email"
        type="email"
        required
        autocomplete="username"
        class="mt-1 w-full border border-line bg-canvas px-3 py-2 text-ink"
      />
      <label class="mt-5 block text-sm text-muted" for="reset-password">Новый пароль</label>
      <input
        id="reset-password"
        name="password"
        type="password"
        required
        minlength="8"
        autocomplete="new-password"
        class="mt-1 w-full border border-line bg-canvas px-3 py-2 text-ink"
      />
      <label class="mt-5 block text-sm text-muted" for="reset-repeat">Повтор пароля</label>
      <input
        id="reset-repeat"
        name="repeat"
        type="password"
        required
        minlength="8"
        autocomplete="new-password"
        class="mt-1 w-full border border-line bg-canvas px-3 py-2 text-ink"
      />
      <button type="submit" class="btn-primary mt-6 w-full">Задать новый пароль</button>
      <button type="button" class="mt-4 w-full text-sm text-primary" data-show-login>Ко входу</button>
      <p class="mt-3 text-sm text-muted" data-login-status></p>
    </form>
  </div>
</AdminLoginLayout>
