---
import Breadcrumb from "../../../components/Breadcrumb.astro";
import CaseCard from "../../../components/CaseCard.astro";
import CtaBand from "../../../components/CtaBand.astro";
import CtaPair from "../../../components/CtaPair.astro";
import Layout from "../../../layouts/Layout.astro";
import { CASES_INDEX } from "../../../lib/copy/cases";
import { HOME } from "../../../lib/copy/home";
import { getCases } from "../../../lib/db";
import { caseFields } from "../../../lib/i18n";

const cases = await getCases();
const meta = CASES_INDEX.ru;
const copy = HOME.ru;
---

<Layout locale="ru" title={meta.title} description={meta.description}>
  <div class="wrap py-16 md:py-24">
    <Breadcrumb items={[{ href: "/ru", label: "Главная" }, { href: "/ru/cases", label: "Кейсы" }]} />
    <p class="badge mt-8">Кейсы</p>
    <h1 class="page-h1 mt-4 max-w-3xl">
      Бизнес-проблема. Инсайт. Решение. Результат.
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">
      Мы не публикуем «разработали приложение на React». Каждый кейс начинается с того, как работала
      компания, что показал аудит, что внедрили и какая цифра изменилась.
    </p>
    <div class="mt-8">
      <CtaPair locale="ru" />
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        cases.map((item) => {
          const view = caseFields(item, "ru");
          return (
            <CaseCard
              href={`/ru/cases/${item.slug}`}
              industry={view.industry}
              employees={view.employees}
              title={view.title}
              subtitle={view.subtitle}
              metrics={view.metrics}
              readLabel="Читать кейс"
            />
          );
        })
      }
    </div>
  </div>

  <CtaBand h2={copy.finalH2} text={copy.final} locale="ru" />
</Layout>
