---
import LandingPage from "../../components/LandingPage.astro";
import { LANDING_SLUGS, LANDING_BY_SLUG } from "../../lib/copy/landings";

export function getStaticPaths() {
  return LANDING_SLUGS.filter((slug) => slug !== "ai-audit").map((slug) => ({
    params: { slug },
    props: { landing: LANDING_BY_SLUG[slug] },
  }));
}

const { landing } = Astro.props;
---

<LandingPage locale="ru" landing={landing} />
