---
import { getRelativeLocaleUrl } from "astro:i18n";
import { compactPath, localeFromAstro } from "../lib/i18n";
import { SITE } from "../lib/types";

interface Props {
  lang?: "ru" | "en";
}

const lang = Astro.props.lang ?? localeFromAstro(Astro.currentLocale, Astro.url.pathname);
const home = compactPath(getRelativeLocaleUrl(lang, "/"));
const mark = lang === "ru" ? SITE.markRu : SITE.mark;
const word = lang === "ru" ? " Интеллект" : " Intellect";
const label = lang === "ru" ? SITE.nameRu : SITE.name;
---

<a
  href={home}
  class="logo inline-flex items-baseline font-display text-base leading-none no-underline sm:text-lg"
  style="color: var(--color-text)"
  aria-label={label}
>
  <span class="max-sm:hidden">
    <span class="font-bold">{mark}</span><span class="font-normal">{word}</span>
  </span>
  <span class="font-bold sm:hidden">{mark}</span>
</a>
