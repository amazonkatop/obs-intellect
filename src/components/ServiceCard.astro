---
import { localeFromAstro, serviceFields } from "../lib/i18n";
import type { ServiceRecord } from "../lib/types";

interface Props {
  service: ServiceRecord;
  index?: number;
}

const { service, index } = Astro.props;
const locale = localeFromAstro(Astro.currentLocale);
const copy = serviceFields(service, locale);
const n = typeof index === "number" ? String(index + 1).padStart(2, "0") : null;
---

<article class="panel mt-4">
  <div class="grid gap-4 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-3">
      {n && <p class="font-mono text-sm font-medium tracking-[0.08em] text-accent">{n}</p>}
      <p class="badge mt-3">
        {service.is_saas ? (locale === "ru" ? "Собственный продукт, НИОКР" : "Own product, R&D") : locale === "ru" ? "Услуга" : "Service"}
      </p>
    </div>
    <div class="md:col-span-9">
      <h3 class="text-xl font-semibold md:text-2xl">{copy.title}</h3>
      <p class="mt-3 max-w-3xl text-base leading-7 text-muted">{copy.description}</p>
      <p class="mt-4 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-accent">{copy.price}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {service.stack.map((item) => <li class="badge">{item}</li>)}
      </ul>
    </div>
  </div>
</article>
