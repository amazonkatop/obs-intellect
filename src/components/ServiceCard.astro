---
import { localeFromAstro, serviceFields } from "../lib/i18n";
import type { ServiceRecord } from "../lib/types";

interface Props {
  service: ServiceRecord;
  index?: number;
}

const { service, index } = Astro.props;
const locale = localeFromAstro(Astro.currentLocale);
const copy = serviceFields(service, locale);
const n = typeof index === "number" ? String(index + 1).padStart(2, "0") : null;
---

<article class="grid gap-4 border-t border-line py-8 md:grid-cols-12 md:gap-10">
  <div class="md:col-span-3">
    {n && <p class="font-display text-2xl text-accent">{n}</p>}
    <p class="mt-2 text-sm text-muted">
      {service.is_saas ? (locale === "ru" ? "Собственный продукт, НИОКР" : "Own product, R&D") : locale === "ru" ? "Услуга" : "Service"}
    </p>
  </div>
  <div class="md:col-span-9">
    <h3 class="text-xl md:text-2xl">{copy.title}</h3>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-muted md:text-base">{copy.description}</p>
    <p class="mt-4 text-sm text-accent">{copy.price}</p>
    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted">
      {service.stack.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</article>
