---
import { getRelativeLocaleUrl } from "astro:i18n";
import Breadcrumb from "./Breadcrumb.astro";
import CtaBand from "./CtaBand.astro";
import CtaPair from "./CtaPair.astro";
import FaqList from "./FaqList.astro";
import RussiaBlock from "./RussiaBlock.astro";
import Layout from "../layouts/Layout.astro";
import { landingFaq, LANDING_BY_SLUG, type Landing } from "../lib/copy/landings";
import { HOME } from "../lib/copy/home";
import { compactPath, locText, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  landing: Landing;
}

const { locale, landing } = Astro.props;
const t = (value: { en: string; ru: string }) => locText(locale, value);
const home = compactPath(getRelativeLocaleUrl(locale, "/"));
const path = compactPath(getRelativeLocaleUrl(locale, `/${landing.slug}`));
const copy = HOME[locale];
const faq = landingFaq(landing, locale);
const schema = faq.length
  ? [
      {
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      },
    ]
  : [];
---

<Layout locale={locale} title={t(landing.title)} description={t(landing.description)} schema={schema}>
  <div class="wrap py-16 md:pb-8 md:pt-24">
    <Breadcrumb
      items={[
        { href: home, label: locale === "ru" ? "Главная" : "Home" },
        { href: path, label: t(landing.nav) },
      ]}
    />
    {landing.kicker && <p class="badge mt-8">{t(landing.kicker)}</p>}
    <h1 class="page-h1 mt-4 max-w-4xl">{t(landing.h1)}</h1>
    <p class="mt-6 max-w-3xl text-base leading-7 text-muted md:text-lg md:leading-8">{t(landing.lead)}</p>
    <div class="mt-8">
      <CtaPair locale={locale} />
    </div>
  </div>

  {
    landing.sections.map((section) => (
      <section class="border-t border-line">
        <div class="wrap py-16 md:py-20">
          <h2 class="page-h2 max-w-3xl">{t(section.h2)}</h2>
          {section.body && <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{t(section.body)}</p>}
          {section.items && (
            <ol
              class:list={[
                "mt-12 grid gap-4",
                section.numbered ? "md:grid-cols-2" : "sm:grid-cols-2 lg:grid-cols-3",
              ]}
            >
              {section.items.map((item, index) => (
                <li class="panel">
                  {section.numbered && (
                    <p class="font-mono text-sm font-medium tracking-[0.08em] text-accent">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                  )}
                  <h3 class:list={["text-lg font-semibold", section.numbered && "mt-3"]}>{t(item.title)}</h3>
                  <p class="mt-2 text-base leading-7 text-muted">{t(item.text)}</p>
                </li>
              ))}
            </ol>
          )}
        </div>
      </section>
    ))
  }

  {landing.showRussia && locale === "ru" && <RussiaBlock locale={locale} />}

  {
    landing.related.length > 0 && (
      <section class="border-t border-line">
        <div class="wrap py-16">
          <h2 class="page-h2">{locale === "ru" ? "Читать дальше" : "Related"}</h2>
          <ul class="mt-8 grid gap-4 sm:grid-cols-2">
            {landing.related.map((slug) => {
              const related = LANDING_BY_SLUG[slug];
              if (!related) return null;
              const href = compactPath(getRelativeLocaleUrl(locale, `/${related.slug}`));
              return (
                <li>
                  <a href={href} class="panel panel-link">
                    <h3 class="text-lg font-semibold text-ink">{t(related.nav)}</h3>
                    <p class="mt-2 text-base leading-7 text-muted">{t(related.description)}</p>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <FaqList items={faq} heading={copy.faqH2} />

  <CtaBand h2={copy.finalH2} text={copy.final} locale={locale} />
</Layout>
