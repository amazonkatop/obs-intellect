---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import CaseCard from "./CaseCard.astro";
import { caseCover } from "../lib/covers";
import { caseFields, localeFromAstro } from "../lib/i18n";
import type { CaseRecord } from "../lib/types";

interface Props {
  item: CaseRecord;
}

const { item } = Astro.props;
const locale = localeFromAstro(Astro.currentLocale);
const copy = caseFields(item, locale);
---

<article class="wrap narrow py-16 md:py-24">
  <p class="text-sm text-muted">{copy.clientName}</p>
  <h1 class="page-h1 mt-3">{copy.title}</h1>

  <div class="mt-8">
    <CaseCard
      industry={copy.industry}
      employees={copy.employees}
      title={copy.title}
      subtitle={copy.subtitle}
      metrics={copy.metrics}
      showTitle={false}
    />
  </div>

  <div class="mt-10 border border-line">
    <Image
      src={caseCover(item.slug)}
      alt={copy.alt}
      width={960}
      height={540}
      class="w-full"
      densities={[1, 2]}
    />
  </div>

  <h2 class="page-h2 mt-12">
    {locale === "ru" ? "Бизнес-проблема" : "Business problem"}
  </h2>
  <p class="mt-4 text-base leading-7 text-muted">{copy.problem}</p>

  <h2 class="page-h2 mt-10">
    {locale === "ru" ? "Что обнаружили и что сделали" : "Insight and solution"}
  </h2>
  <p class="mt-4 text-base leading-7 text-muted whitespace-pre-line">{copy.solution}</p>

  <h2 class="page-h2 mt-10">
    {locale === "ru" ? "Результат" : "Result"}
  </h2>
  <p class="mt-4 text-base leading-7 text-accent">{copy.result}</p>

  <p class="mt-12 text-sm">
    <a href={getRelativeLocaleUrl(locale, "/cases")} class="text-primary no-underline">
      {locale === "ru" ? "Все кейсы" : "All cases"}
    </a>
    <span class="text-muted"> / </span>
    <a href={getRelativeLocaleUrl(locale, "/contacts")} class="text-primary no-underline">
      {locale === "ru" ? "Провести аудит" : "Start a business audit"}
    </a>
  </p>
</article>
