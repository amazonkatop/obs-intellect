---
import { getRelativeLocaleUrl } from "astro:i18n";
import CaseCard from "./CaseCard.astro";
import CtaBand from "./CtaBand.astro";
import FaqList from "./FaqList.astro";
import Layout from "../layouts/Layout.astro";
import { CHANGE_OFFERS, HOME, METHOD_STEPS, PLATFORM_POINTS, WHY_ROLES } from "../lib/copy/home";
import { SITE_FAQ } from "../lib/copy/faq";
import { compactPath, locText, type Locale } from "../lib/i18n";
import { TEAM, teamCopy } from "../lib/team";
import type { CaseRecord } from "../lib/types";

interface Props {
  locale: Locale;
  cases: CaseRecord[];
}

const { locale, cases } = Astro.props;
const copy = HOME[locale];
const contacts = compactPath(getRelativeLocaleUrl(locale, "/contacts"));
const audit = compactPath(getRelativeLocaleUrl(locale, "/business-audit"));
const platform = compactPath(getRelativeLocaleUrl(locale, "/saas-development"));
const startup = compactPath(getRelativeLocaleUrl(locale, "/startup-mvp"));
const about = compactPath(getRelativeLocaleUrl(locale, "/about"));
const casesHref = compactPath(getRelativeLocaleUrl(locale, "/cases"));
const faq = SITE_FAQ[locale];
const loc = (value: { en: string; ru: string }) => locText(locale, value);
const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Layout locale={locale} title={copy.title} description={copy.description} schema={schema}>
  <section class="border-b border-line">
    <div class="wrap grid gap-12 py-20 md:grid-cols-12 md:py-28">
      <div class="md:col-span-7">
        <h1 class="text-4xl leading-tight md:text-6xl">{copy.h1}</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-muted">{copy.lead}</p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a href={contacts} class="btn-primary">{copy.ctaPrimary}</a>
          <a href={`${contacts}#checkup`} class="btn-ghost">{copy.ctaSecondary}</a>
        </div>
        <p class="mt-6 text-sm text-muted">{copy.kicker}</p>
      </div>
      <aside class="flex flex-col justify-end gap-6 border-t border-line pt-8 md:col-span-5 md:border-l md:border-t-0 md:pl-10 md:pt-0">
        <p class="text-sm leading-6 text-muted">{copy.formula}</p>
        <p class="font-display text-xl leading-8 text-ink">{copy.manifestoH2}</p>
        <p class="text-sm leading-6 text-muted">{copy.manifesto}</p>
      </aside>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="max-w-3xl text-2xl md:text-4xl">{copy.startPointH2}</h2>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{copy.startPoint}</p>
      <p class="mt-8">
        <a href={audit} class="btn-primary">{copy.startCta}</a>
      </p>
    </div>
  </section>

  <section id="method" class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="max-w-3xl text-2xl md:text-4xl">{copy.howH2}</h2>
      <ol class="mt-12 grid gap-0 md:grid-cols-2 lg:grid-cols-3">
        {
          METHOD_STEPS.map((step) => (
            <li class="method-step border-t border-line py-8 md:pr-10">
              <p class="font-display text-3xl text-accent">{step.n}</p>
              <h3 class="mt-3 text-lg">{loc(step.title)}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{loc(step.text)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="max-w-3xl text-2xl md:text-4xl">{copy.platformH2}</h2>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{copy.platform}</p>
      <div class="mt-12 grid gap-0 md:grid-cols-3 md:divide-x md:divide-line">
        {
          PLATFORM_POINTS.map((item) => (
            <article class="border-t border-line py-8 md:border-t-0 md:px-8 md:first:pl-0 md:last:pr-0">
              <h3 class="text-lg">{loc(item.title)}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{loc(item.text)}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-8">
        <a href={platform} class="text-sm text-primary no-underline">
          {locale === "ru" ? "О платформе" : "About the platform"}
        </a>
      </p>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="max-w-3xl text-2xl md:text-4xl">{copy.changeH2}</h2>
      <ul class="mt-12 grid gap-0 md:grid-cols-2">
        {
          CHANGE_OFFERS.map((offer) => (
            <li class="border-t border-line py-8 md:pr-10">
              <a
                href={compactPath(getRelativeLocaleUrl(locale, offer.href))}
                class="text-xl text-ink no-underline hover:text-primary md:text-2xl"
              >
                {loc(offer.title)}
              </a>
              <p class="mt-3 max-w-lg text-sm leading-6 text-muted">{loc(offer.text)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    locale === "ru" && (
      <section class="border-b border-line">
        <div class="wrap py-20">
          <h2 class="max-w-3xl text-2xl md:text-4xl">{HOME.ru.russiaH2}</h2>
          <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{HOME.ru.russia}</p>
          <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{HOME.ru.proof}</p>
        </div>
      </section>
    )
  }

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="max-w-3xl text-2xl md:text-4xl">{copy.techH2}</h2>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{copy.tech}</p>
      <ul class="mt-12 grid gap-0 sm:grid-cols-2 md:grid-cols-3">
        {
          copy.techItems.map((item) => (
            <li class="border-t border-line py-6 pr-6">
              <h3 class="text-lg">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="max-w-3xl text-2xl md:text-4xl">{copy.whyH2}</h2>
      <ul class="mt-12 grid gap-0 sm:grid-cols-2 md:grid-cols-3">
        {
          WHY_ROLES.map((role) => (
            <li class="border-t border-line py-6 pr-6">
              <h3 class="text-lg">{loc(role.title)}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{loc(role.text)}</p>
            </li>
          ))
        }
      </ul>
      <h3 class="mt-16 text-xl md:text-2xl">{copy.differentiatorH2}</h3>
      <p class="mt-4 max-w-3xl text-base leading-7 text-muted">{copy.differentiator}</p>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-2xl md:text-4xl">{copy.teamH2}</h2>
        <a href={`${about}#team`} class="text-sm text-primary no-underline">{copy.teamLink}</a>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {
          TEAM.map((member) => {
            const person = teamCopy(member, locale);
            return (
              <a href={`${about}#${member.id}`} class="block border-t border-line pt-6 no-underline">
                <p class="text-sm text-muted">{person.role}</p>
                <p class="mt-2 font-display text-xl text-ink">{person.name}</p>
                <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted">{person.bio}</p>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-2xl md:text-4xl">{copy.casesH2}</h2>
        <a href={casesHref} class="text-sm text-primary no-underline">{copy.casesLink}</a>
      </div>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {cases.map((item) => <CaseCard item={item} compact />)}
      </div>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="max-w-3xl text-2xl md:text-4xl">{copy.startupH2}</h2>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{copy.startup}</p>
      <p class="mt-8">
        <a href={startup} class="btn-primary">{copy.startupCta}</a>
      </p>
    </div>
  </section>

  <FaqList items={faq} heading={copy.faqH2} />

  <CtaBand
    h2={copy.finalH2}
    text={copy.final}
    primaryHref={contacts}
    primaryLabel={copy.ctaPrimary}
    secondaryHref={`${contacts}#checkup`}
    secondaryLabel={copy.ctaSecondary}
    note={copy.checkup}
  />
</Layout>
