---
import { getRelativeLocaleUrl } from "astro:i18n";
import CaseCard from "./CaseCard.astro";
import CtaBand from "./CtaBand.astro";
import FaqList from "./FaqList.astro";
import Layout from "../layouts/Layout.astro";
import { CHANGE_OFFERS, HERO_METRICS, HOME, METHOD_STEPS, PLATFORM_POINTS, WHY_ROLES } from "../lib/copy/home";
import { SITE_FAQ } from "../lib/copy/faq";
import { compactPath, caseFields, locText, type Locale } from "../lib/i18n";
import { TEAM, teamCopy } from "../lib/team";
import type { CaseRecord } from "../lib/types";

interface Props {
  locale: Locale;
  cases: CaseRecord[];
}

const { locale, cases } = Astro.props;
const copy = HOME[locale];
const contacts = compactPath(getRelativeLocaleUrl(locale, "/contacts"));
const audit = compactPath(getRelativeLocaleUrl(locale, "/business-audit"));
const platform = compactPath(getRelativeLocaleUrl(locale, "/saas-development"));
const startup = compactPath(getRelativeLocaleUrl(locale, "/startup-mvp"));
const about = compactPath(getRelativeLocaleUrl(locale, "/about"));
const casesHref = compactPath(getRelativeLocaleUrl(locale, "/cases"));
const faq = SITE_FAQ[locale];
const loc = (value: { en: string; ru: string }) => locText(locale, value);
const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Layout locale={locale} title={copy.title} description={copy.description} schema={schema}>
  <section class="border-b border-line">
    <div class="wrap grid gap-12 py-16 md:grid-cols-12 md:py-24">
      <div class="md:col-span-7">
        <h1 class="page-h1 max-w-3xl">{copy.h1}</h1>
        <div class="badge-row mt-6">
          {copy.kicker.split("·").map((tag) => <span class="badge">{tag.trim()}</span>)}
        </div>
        <p class="mt-6 max-w-xl text-base leading-7 text-muted md:text-lg md:leading-8">{copy.lead}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={contacts} class="btn-primary">{copy.ctaPrimary}</a>
          <a href={`${contacts}#checkup`} class="btn-secondary">{copy.ctaSecondary}</a>
        </div>
      </div>
      <aside class="flex flex-col justify-end gap-5 border-t border-line pt-8 md:col-span-5 md:border-l md:border-t-0 md:pl-10 md:pt-0">
        <p class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted">{copy.formula}</p>
        <p class="text-xl font-semibold leading-7 tracking-[-0.02em] text-ink">{copy.manifestoH2}</p>
        <p class="text-base leading-7 text-muted">{copy.manifesto}</p>
      </aside>
    </div>
    <div class="wrap">
      <div class="metric-strip">
        {
          HERO_METRICS.map((item) => (
            <article>
              <p class="metric-value">
                {item.value}
                {"unit" in item && item.unit ? <span class="metric-unit">{loc(item.unit)}</span> : null}
              </p>
              <p class="mt-3 text-base leading-6 text-muted">{loc(item.label)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="page-h2 max-w-3xl">{copy.startPointH2}</h2>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{copy.startPoint}</p>
      <p class="mt-8">
        <a href={audit} class="btn-primary">{copy.startCta}</a>
      </p>
    </div>
  </section>

  <section id="method" class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="page-h2 max-w-3xl">{copy.howH2}</h2>
      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          METHOD_STEPS.map((step) => (
            <li class="method-step panel">
              <p class="font-mono text-sm font-medium tracking-[0.08em] text-accent">{step.n}</p>
              <h3 class="mt-3 text-lg font-semibold">{loc(step.title)}</h3>
              <p class="mt-3 text-base leading-7 text-muted">{loc(step.text)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="page-h2 max-w-3xl">{copy.platformH2}</h2>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{copy.platform}</p>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          PLATFORM_POINTS.map((item) => (
            <article class="panel">
              <h3 class="text-lg font-semibold">{loc(item.title)}</h3>
              <p class="mt-3 text-base leading-7 text-muted">{loc(item.text)}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-8">
        <a href={platform} class="text-sm text-primary no-underline">
          {locale === "ru" ? "О платформе" : "About the platform"}
        </a>
      </p>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="page-h2 max-w-3xl">{copy.changeH2}</h2>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          CHANGE_OFFERS.map((offer, index) => (
            <li class:list={[index === 0 && "offer-featured"]}>
              <a
                href={compactPath(getRelativeLocaleUrl(locale, offer.href))}
                class="panel panel-link"
              >
                <h3 class="text-xl font-semibold text-ink">{loc(offer.title)}</h3>
                <p class="mt-3 text-base leading-7 text-muted">{loc(offer.text)}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    locale === "ru" && (
      <section class="border-b border-line">
        <div class="wrap py-20">
          <h2 class="page-h2 max-w-3xl">{HOME.ru.russiaH2}</h2>
          <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{HOME.ru.russia}</p>
          <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{HOME.ru.proof}</p>
          <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {copy.techItems.map((item) => (
              <li class="panel">
                <p class="badge mb-4">{item.title}</p>
                <p class="text-base leading-7 text-muted">{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="page-h2 max-w-3xl">{copy.techH2}</h2>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{copy.tech}</p>
      {
        locale === "en" && (
          <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {copy.techItems.map((item) => (
              <li class="panel">
                <p class="badge mb-4">{item.title}</p>
                <p class="text-base leading-7 text-muted">{item.text}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="page-h2 max-w-3xl">{copy.whyH2}</h2>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        {
          WHY_ROLES.map((role) => (
            <li class="panel">
              <h3 class="text-lg font-semibold">{loc(role.title)}</h3>
              <p class="mt-2 text-base leading-7 text-muted">{loc(role.text)}</p>
            </li>
          ))
        }
      </ul>
      <h3 class="page-h2 mt-16">{copy.differentiatorH2}</h3>
      <p class="mt-4 max-w-3xl text-base leading-7 text-muted">{copy.differentiator}</p>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <div class="flex items-end justify-between gap-4">
        <h2 class="page-h2">{copy.teamH2}</h2>
        <a href={`${about}#team`} class="text-base text-primary no-underline">{copy.teamLink}</a>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          TEAM.map((member) => {
            const person = teamCopy(member, locale);
            return (
              <a href={`${about}#${member.id}`} class="panel panel-link">
                <p class="badge">{person.role}</p>
                <p class="mt-4 text-xl font-semibold text-ink">{person.name}</p>
                <p class="mt-3 line-clamp-3 text-base leading-7 text-muted">{person.bio}</p>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <div class="flex items-end justify-between gap-4">
        <h2 class="page-h2">{copy.casesH2}</h2>
        <a href={casesHref} class="text-base text-primary no-underline">{copy.casesLink}</a>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          cases.map((item) => {
            const view = caseFields(item, locale);
            return (
              <CaseCard
                href={compactPath(getRelativeLocaleUrl(locale, `/cases/${item.slug}`))}
                industry={view.industry}
                employees={view.employees}
                title={view.title}
                subtitle={view.subtitle}
                metrics={view.metrics}
                readLabel={locale === "ru" ? "Читать кейс" : "Read the case"}
              />
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap py-20">
      <h2 class="page-h2 max-w-3xl">{copy.startupH2}</h2>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted">{copy.startup}</p>
      <p class="mt-8">
        <a href={startup} class="btn-primary">{copy.startupCta}</a>
      </p>
    </div>
  </section>

  <FaqList items={faq} heading={copy.faqH2} />

  <CtaBand
    h2={copy.finalH2}
    text={copy.final}
    primaryHref={contacts}
    primaryLabel={copy.ctaPrimary}
    secondaryHref={`${contacts}#checkup`}
    secondaryLabel={copy.ctaSecondary}
    note={copy.checkup}
  />
</Layout>
