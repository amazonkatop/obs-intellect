---
import { Image } from "astro:assets";
import { teamCopy, type TeamMember } from "../lib/team";
import type { Locale } from "../lib/i18n";

interface Props {
  member: TeamMember;
  locale: Locale;
}

const { member, locale } = Astro.props;
const copy = teamCopy(member, locale);
---

<article id={member.id} class="border-t border-line pt-8">
  <Image
    src={member.photo}
    alt={locale === "ru" ? `${copy.name}, ${copy.role}, OBS Intellect` : `${copy.name}, ${copy.role} at OBS Intellect`}
    width={720}
    height={960}
    class="aspect-[3/4] w-full object-cover object-top"
    densities={[1, 2]}
  />
  <p class="eyebrow mt-6">{copy.role}</p>
  <h2 class="mt-3 text-2xl md:text-3xl">{copy.name}</h2>
  <p class="mt-4 text-sm leading-7 text-muted">{copy.bio}</p>
  <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted">
    {copy.focus.map((item) => <li>{item}</li>)}
  </ul>
</article>
