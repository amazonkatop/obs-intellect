---
interface Props {
  h2: string;
  text: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  note?: string;
}

const { h2, text, primaryHref, primaryLabel, secondaryHref, secondaryLabel, note } = Astro.props;
---

<section class="border-t border-line">
  <div class="wrap py-20 md:py-24">
    <h2 class="max-w-3xl text-2xl md:text-4xl">{h2}</h2>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{text}</p>
    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a href={primaryHref} class="btn-primary">{primaryLabel}</a>
      {
        secondaryHref && secondaryLabel && (
          <a href={secondaryHref} class="btn-ghost">
            {secondaryLabel}
          </a>
        )
      }
    </div>
    {note && <p class="mt-6 max-w-2xl text-sm leading-6 text-muted">{note}</p>}
  </div>
</section>
