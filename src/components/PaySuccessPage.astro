---
import CheckoutLayout from "../layouts/CheckoutLayout.astro";
import { chatReturnHref } from "../lib/pay";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isRu = locale === "ru";
const chatBase = chatReturnHref(locale, "");
---

<CheckoutLayout
  locale={locale}
  title={isRu ? "Оплата принята" : "Payment received"}
  description={
    isRu
      ? "Подтверждение оплаты экспресс-сессии с бизнес-аналитиком."
      : "Confirmation that the express analyst session has been paid."
  }
>
  <div class="wrap narrow py-12 md:py-16">
    <p class="badge">{isRu ? "Оплата" : "Payment"}</p>
    <h1 class="page-h1 mt-4">{isRu ? "Оплата подтверждена" : "Payment confirmed"}</h1>
    <p class="mt-5 text-base leading-7 text-muted">
      {
        isRu
          ? "Мы получили подтверждение по экспресс-сессии. Вернитесь в чат — аналитик продолжит разбор с того же диалога."
          : "The express session is marked as paid. Return to the chat so the analyst can continue the same conversation."
      }
    </p>
    <p class="mt-4 text-sm text-muted">
      {isRu ? "Номер сессии:" : "Session id:"}
      <span class="ml-2 font-mono text-ink" data-pay-field="session_id">—</span>
    </p>
    <p class="mt-8">
      <a id="chat-return" class="btn-primary" href={chatBase}>
        {isRu ? "Вернуться в чат" : "Return to the chat"}
      </a>
    </p>
    <p class="mt-4 text-xs leading-5 text-muted">
      {
        isRu
          ? "Пока Т-Касса не подключена, эта страница — макет успеха. Реальный статус карточки клиента выставит вебхук OBS Pulse после проверки подписи банка."
          : "Until T-Kassa is connected this is a success mock. The live client-card status will be set by the OBS Pulse webhook after the bank signature is verified."
      }
    </p>
  </div>
  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var sessionId = (params.get("session_id") || "").trim();
      var el = document.querySelector('[data-pay-field="session_id"]');
      var link = document.getElementById("chat-return");
      if (el) el.textContent = sessionId || "—";
      if (link && sessionId) {
        var url = new URL(link.getAttribute("href"), window.location.origin);
        url.searchParams.set("session_id", sessionId);
        link.setAttribute("href", url.pathname + url.search);
      }
    })();
  </script>
</CheckoutLayout>
