---
import CheckoutLayout from "../layouts/CheckoutLayout.astro";
import { chatReturnHref } from "../lib/pay";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isRu = locale === "ru";
const chatBase = chatReturnHref(locale, "");
const store = isRu ? "/ru/pay" : "/pay";
const home = isRu ? "/ru" : "/";
---

<CheckoutLayout
  locale={locale}
  title={isRu ? "Оплата принята" : "Payment received"}
  description={
    isRu
      ? "Подтверждение оплаты услуги на сайте ООО «ОБС Интеллект»."
      : "Confirmation that a service on the OBS Intellect site has been paid."
  }
>
  <div class="wrap narrow py-12 md:py-16">
    <p class="badge">{isRu ? "Оплата" : "Payment"}</p>
    <h1 class="page-h1 mt-4">{isRu ? "Оплата подтверждена" : "Payment confirmed"}</h1>
    <p class="mt-5 text-base leading-7 text-muted" data-success-copy>
      {
        isRu
          ? "Мы зафиксировали оплату выбранной услуги. Если вы пришли из чата — вернитесь в диалог, чтобы продолжить с тем же слотом."
          : "The selected service is marked as paid. If you came from the chat, return so the same slot can continue."
      }
    </p>
    <p class="mt-4 text-sm text-muted" data-session-row hidden>
      {isRu ? "Номер сессии:" : "Session id:"}
      <span class="ml-2 font-mono text-ink" data-pay-field="session_id">—</span>
    </p>
    <p class="mt-8 flex flex-wrap gap-3">
      <a id="chat-return" class="btn-primary" href={chatBase} hidden>
        {isRu ? "Вернуться в чат" : "Return to the chat"}
      </a>
      <a id="store-return" class="btn-primary" href={store}>
        {isRu ? "К услугам" : "Back to services"}
      </a>
      <a class="btn-secondary" href={home}>{isRu ? "На главную" : "Home"}</a>
    </p>
    <p class="mt-4 text-xs leading-5 text-muted">
      {
        isRu
          ? "Пока Т-Касса не подключена, эта страница — макет успеха. Реальный статус выставит вебхук после проверки подписи банка."
          : "Until T-Kassa is connected this is a success mock. Live status will be set by the webhook after the bank signature is verified."
      }
    </p>
  </div>
  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var sessionId = (params.get("session_id") || "").trim();
      var el = document.querySelector('[data-pay-field="session_id"]');
      var row = document.querySelector("[data-session-row]");
      var chat = document.getElementById("chat-return");
      var store = document.getElementById("store-return");
      if (el) el.textContent = sessionId || "—";
      if (sessionId && row) row.hidden = false;
      if (sessionId && chat) {
        chat.hidden = false;
        var url = new URL(chat.getAttribute("href"), window.location.origin);
        url.searchParams.set("session_id", sessionId);
        chat.setAttribute("href", url.pathname + url.search);
        if (store) store.className = "btn-secondary";
      }
    })();
  </script>
</CheckoutLayout>
