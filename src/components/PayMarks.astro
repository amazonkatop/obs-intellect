---
const items = [
  { id: "tbank", label: "Т-Банк" },
  { id: "visa", label: "Visa" },
  { id: "mastercard", label: "Mastercard" },
  { id: "mir", label: "МИР" },
] as const;
---

<ul class="flex flex-wrap items-center gap-3" aria-label="Принимаемые платёжные системы">
  {
    items.map((item) => (
      <li>
        <span class="pay-mark" data-brand={item.id} title={item.label}>
          <span class="sr-only">{item.label}</span>
          {item.id === "tbank" && (
            <svg viewBox="0 0 88 28" width="88" height="28" aria-hidden="true">
              <rect width="88" height="28" rx="4" fill="#FFDD2D" />
              <text x="44" y="19" text-anchor="middle" fill="#111" font-size="11" font-family="Golos Text, sans-serif" font-weight="700">
                Т-Банк
              </text>
            </svg>
          )}
          {item.id === "visa" && (
            <svg viewBox="0 0 72 28" width="72" height="28" aria-hidden="true">
              <rect width="72" height="28" rx="4" fill="#1A1F71" />
              <text x="36" y="19" text-anchor="middle" fill="#fff" font-size="12" font-family="Golos Text, sans-serif" font-weight="700" letter-spacing="0.12em">
                VISA
              </text>
            </svg>
          )}
          {item.id === "mastercard" && (
            <svg viewBox="0 0 72 28" width="72" height="28" aria-hidden="true">
              <rect width="72" height="28" rx="4" fill="#000" />
              <circle cx="30" cy="14" r="8" fill="#EB001B" />
              <circle cx="42" cy="14" r="8" fill="#F79E1B" />
              <path d="M36 7.5a8 8 0 0 1 0 13 8 8 0 0 1 0-13z" fill="#FF5F00" />
            </svg>
          )}
          {item.id === "mir" && (
            <svg viewBox="0 0 72 28" width="72" height="28" aria-hidden="true">
              <rect width="72" height="28" rx="4" fill="#0D6556" />
              <text x="36" y="19" text-anchor="middle" fill="#fff" font-size="12" font-family="Golos Text, sans-serif" font-weight="700">
                МИР
              </text>
            </svg>
          )}
        </span>
      </li>
    ))
  }
</ul>
