---
import { getRelativeLocaleUrl } from "astro:i18n";
import { FOOTER_BUILD, FOOTER_PRACTICE } from "../lib/copy/nav";
import { HOME } from "../lib/copy/home";
import { compactPath, IT_ACCREDITATION_PATH, localeFromAstro } from "../lib/i18n";
import { LEGAL_PATHS } from "../lib/pay";
import { SITE } from "../lib/types";
import Logo from "./Logo.astro";

interface Props {
  locale?: "en" | "ru";
}

const locale = Astro.props.locale ?? localeFromAstro(Astro.currentLocale, Astro.url.pathname);
const year = new Date().getFullYear();
const copy = HOME[locale];
const locPath = (href: string) => compactPath(getRelativeLocaleUrl(locale, href));
const aiAudit = locPath("/ai-audit");
const aiAuditLabel = locale === "ru" ? "/ru/ai-audit" : "/ai-audit";
---

<footer class="border-t border-line">
  <div class="wrap grid gap-12 py-20 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo lang={locale} />
      <p class="mt-4 max-w-sm text-base leading-7 text-muted">
        {locale === "ru" ? SITE.descriptionRu : SITE.description}
      </p>
      <p class="mt-4 font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-5 text-muted">{copy.formula}</p>
    </div>

    <div>
      <p class="badge">{locale === "ru" ? "Практика" : "Practice"}</p>
      <ul class="mt-4 space-y-3 text-base">
        {
          FOOTER_PRACTICE[locale].map((link) => (
            <li>
              <a class="text-ink no-underline hover:text-primary" href={locPath(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="badge">{locale === "ru" ? "Продукт" : "Build"}</p>
      <ul class="mt-4 space-y-3 text-base">
        {
          FOOTER_BUILD[locale].map((link) => (
            <li>
              <a class="text-ink no-underline hover:text-primary" href={locPath(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="text-ink no-underline hover:text-primary" href={locPath("/about")}>
            {locale === "ru" ? "Команда" : "Team"}
          </a>
        </li>
        <li>
          <a class="text-ink no-underline hover:text-primary" href={locPath("/cases")}>
            {locale === "ru" ? "Кейсы" : "Cases"}
          </a>
        </li>
        <li>
          <a class="text-ink no-underline hover:text-primary" href={locPath("/pay")}>
            {locale === "ru" ? "Оплата" : "Pay"}
          </a>
        </li>
        <li>
          <a class="text-ink no-underline hover:text-primary" href={locPath("/contacts")}>
            {locale === "ru" ? "Контакты" : "Contact"}
          </a>
        </li>
        <li>
          <a class="text-ink no-underline hover:text-primary" href={IT_ACCREDITATION_PATH}>
            {locale === "ru" ? "Сведения об ИТ-организации (Минцифры)" : "IT organization page (RU)"}
          </a>
        </li>
        <li>
          <a class="text-ink no-underline hover:text-primary" href={LEGAL_PATHS.offer}>
            {locale === "ru" ? "Оферта" : "Offer (RU)"}
          </a>
        </li>
        <li>
          <a class="text-ink no-underline hover:text-primary" href={LEGAL_PATHS.refund}>
            {locale === "ru" ? "Правила возврата" : "Refund policy (RU)"}
          </a>
        </li>
        <li>
          <a class="text-ink no-underline hover:text-primary" href={LEGAL_PATHS.privacy}>
            {locale === "ru" ? "Персональные данные" : "Personal data (RU)"}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-sm leading-6 text-muted">
        {locale === "ru" ? "AI-аудит доступен на странице " : "AI audit is available at "}
        <a href={aiAudit} class="text-primary no-underline hover:underline">{aiAuditLabel}</a>
      </p>
      <p class="mt-6">
        <a class="text-sm text-ink no-underline hover:text-primary" href={`mailto:${SITE.email}`}>
          {SITE.email}
        </a>
      </p>
    </div>
  </div>
  <div class="wrap border-t border-line py-6 text-xs leading-5 text-muted">
    <p>© {year} {SITE.legalShort}</p>
    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
      <a class="text-primary no-underline hover:underline" href={LEGAL_PATHS.offer}>
        {locale === "ru" ? "Оферта" : "Offer"}
      </a>
      <a class="text-primary no-underline hover:underline" href={LEGAL_PATHS.refund}>
        {locale === "ru" ? "Правила возврата" : "Refund policy"}
      </a>
      <a class="text-primary no-underline hover:underline" href={LEGAL_PATHS.privacy}>
        {locale === "ru" ? "Политика обработки персональных данных" : "Personal data policy"}
      </a>
      <a class="text-primary no-underline hover:underline" href={locPath("/pay")}>
        {locale === "ru" ? "Оплата" : "Pay"}
      </a>
    </p>
    {
      locale === "en" && (
        <p class="mt-2 max-w-3xl">
          English version is provided for informational purposes only; the Russian version is legally
          binding.
        </p>
      )
    }
  </div>
</footer>
