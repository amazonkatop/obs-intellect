---
import type { CaseMetric } from "../lib/copy/cases";

interface Props {
  industry: string;
  employees: string;
  title: string;
  subtitle: string;
  metrics: CaseMetric[];
  href: string;
  readLabel: string;
}

const { industry, employees, title, subtitle, metrics, href, readLabel } = Astro.props;
---

<a href={href} class="case-card panel panel-link">
  <div class="case-card-top">
    <p class="badge">{industry}</p>
    {employees && <p class="case-card-employees">{employees}</p>}
  </div>
  <h3>{title}</h3>
  <p class="case-card-sub">{subtitle}</p>
  <ul class="case-metrics">
    {
      metrics.slice(0, 3).map((metric) => (
        <li>
          <div class="case-metric-head">
            <span class="case-metric-label">{metric.label}</span>
            <span class="case-metric-value">{metric.value}</span>
          </div>
          <div class="case-metric-bar" aria-hidden="true">
            <span class="case-metric-bar-fill" style={`width:${metric.barWidth}%`} />
          </div>
        </li>
      ))
    }
  </ul>
  <p class="case-card-more">{readLabel} →</p>
</a>
