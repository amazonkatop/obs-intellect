---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { caseCover } from "../lib/covers";
import { caseFields, localeFromAstro } from "../lib/i18n";
import type { CaseRecord } from "../lib/types";

interface Props {
  item: CaseRecord;
  compact?: boolean;
}

const { item, compact = false } = Astro.props;
const locale = localeFromAstro(Astro.currentLocale);
const copy = caseFields(item, locale);
const href = getRelativeLocaleUrl(locale, `/cases/${item.slug}`);
---

<article class="panel overflow-hidden p-0">
  <a href={href} class:list={["block no-underline", !compact && "md:grid md:grid-cols-12 md:gap-10"]}>
    <Image
      src={caseCover(item.slug)}
      alt={locale === "ru" ? `Иллюстрация кейса: ${item.client_name}` : `Visual for ${item.client_name} case`}
      width={960}
      height={540}
      class:list={[compact ? "aspect-[16/9] w-full object-cover" : "aspect-[16/9] w-full object-cover md:col-span-5"]}
      densities={[1, 2]}
    />
    <div class:list={[compact ? "p-6" : "p-6 md:col-span-7 md:flex md:flex-col md:justify-center md:py-8"]}>
      <p class="badge">{item.industry}</p>
      <h3 class="mt-3 text-xl font-semibold text-ink md:text-2xl">{item.client_name}</h3>
      <p class="mt-3 text-base leading-7 text-accent">{copy.result}</p>
      <p class="mt-4 text-base text-primary">
        {locale === "ru" ? "Читать кейс" : "Read the case"}
      </p>
    </div>
  </a>
</article>
