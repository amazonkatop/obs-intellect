# Public site origin used for canonical URLs, Open Graph, and sitemap.xml
# Test (Netlify): Site configuration → Environment variables → PUBLIC_SITE_URL
# Production (Timeweb Cloud Apps): Environment → PUBLIC_SITE_URL (your domain or *.twc1.net)
PUBLIC_SITE_URL=https://obs-intellect.netlify.app

# Timeweb Cloud Managed PostgreSQL. Used only at Astro build time.
# Never prefix this with PUBLIC_ — it must not reach the browser.
# Panel: Databases → cluster → Connection
# Role: a LOGIN user with SELECT on services_and_products, cases, legal_info
# (see GRANT in db/schema.sql). No Supabase SDK, no RLS.
# postgres://USER:PASSWORD@HOST:5432/default_db?sslmode=require
DATABASE_URL=

# Optional: HTTPS endpoint for the contacts form (Formspree, Web3Forms, or your API)
# Leave empty to show the email fallback on /contacts
PUBLIC_FORM_ENDPOINT=

# -----------------------------------------------------------------------------
# T-Kassa / OBS Pulse — NOT for this static site
# Set these on the Pulse backend after the bank issues credentials.
# Do not put them in Netlify for the marketing site. Do not paste them in chat.
# -----------------------------------------------------------------------------
# TKASSA_TERMINAL_KEY=
# TKASSA_SECRET_KEY=
# TKASSA_API_URL=https://securepay.tinkoff.ru/v2
# PULSE_PUBLIC_URL=https://pulse.example.com
# PUBLIC_PULSE_API_URL=https://pulse.example.com

