# Public site origin used for canonical URLs, Open Graph, and sitemap.xml
# Netlify: Site configuration → Environment variables → PUBLIC_SITE_URL
PUBLIC_SITE_URL=https://obs-intellect.netlify.app

# PostgreSQL on the virtual server (Docker: obs-postgres, database obs).
# Build: SELECT on services_and_products, cases, legal_info.
# Runtime (dev / Netlify functions): also write ai_chat_* and integrations.
# Run db/schema.sql, db/chat.sql, db/brand.sql. Never prefix with PUBLIC_.
# Docker without TLS: postgres://obs:PASSWORD@HOST:5432/obs?sslmode=disable
DATABASE_URL=

# Optional: HTTPS endpoint for the contacts form (Formspree, Web3Forms, or your API)
# Leave empty to show the email fallback on /contacts
PUBLIC_FORM_ENDPOINT=

# Admin cookie HMAC secret (optional). If empty, derived from the stored password hash.
# ADMIN_SECRET=
# Recovery email for /ru/admin password reset. Default is set in the server code.
# ADMIN_EMAIL=

# Local AI chat without PostgreSQL: history is written to data/chat/store.json.
# Prefer admin → Интеграции. Env keys are a fallback for this machine only.
# AI_ASSISTANT_PROVIDER=proxyapi
# AI_ASSISTANT_MODEL=gpt-4o-mini
# AI_ASSISTANT_API_KEY=
# AI_ASSISTANT_BASE_URL=
# PROXYAPI_API_KEY=
# VSEGPT_API_KEY=
# GIGACHAT_API_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# YANDEXGPT_API_KEY=
# DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# T-Kassa / OBS Pulse — NOT for this static site
# Set these on the Pulse backend after the bank issues credentials.
# Do not put them in Netlify for the marketing site. Do not paste them in chat.
# -----------------------------------------------------------------------------
# TKASSA_TERMINAL_KEY=
# TKASSA_SECRET_KEY=
# TKASSA_API_URL=https://securepay.tinkoff.ru/v2
# PULSE_PUBLIC_URL=https://pulse.example.com
# PUBLIC_PULSE_API_URL=https://pulse.example.com

